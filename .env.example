# ADIVA Environment Configuration
# Copy this file to .env and fill in the values below.

# Required
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
MISTRAL_API_KEY=your_mistral_api_key_here
JWT_SECRET_KEY=replace_with_a_real_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Recommended local defaults
JOB_EXECUTION_BACKEND=local
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173
ENABLE_AI_RECOVERY=True
AI_RECOVERY_SHADOW_MODE=False

# Only needed when using Celery mode
# JOB_EXECUTION_BACKEND=celery
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
